# Copy this to a private moodle.env outside the repository.
# Cookie mode: copy the Cookie request-header value from your own logged-in session.
MOODLE_COOKIE="MoodleSession=replace-with-your-session"
# Token mode: a Moodle web-service token authorized for core_course_get_contents and file downloads.
MOODLE_TOKEN=replace-with-your-token
# Optional: export a calendar for this course and keep the full URL here, never in config JSON.
MOODLE_COURSE101_ICAL="https://moodle.example.edu/calendar/export_execute.php?authtoken=replace-with-your-export-token"
